# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Variables de entorno. Vite inyecta en el paquete del cliente cualquier
# variable con prefijo VITE_, asi que nada sensible debe llevar ese prefijo
# y ningun .env debe versionarse.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Entregable generado. Se produce con los scripts del proyecto a partir de
# docs/informe-word.txt, asi que no tiene sentido versionar el binario.
INFORME.docx
